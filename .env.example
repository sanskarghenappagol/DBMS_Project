# ==================================================
# Smart Healthcare System - Environment Variables
# ==================================================

# --------------------------------------------------
# MySQL Database Configuration (Primary Relational DB)
# --------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=smart_healthcare

# --------------------------------------------------
# Supabase Authentication & Storage Configuration
# (Used strictly for Auth & Storage; NOT as primary DB)
# --------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# --------------------------------------------------
# MongoDB Configuration (Secondary NoSQL DB)
# (Used for Reports, Reviews, Audit Logs, Vector Search)
# --------------------------------------------------
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=smart_healthcare_nosql

# --------------------------------------------------
# Application Backend API Configuration
# --------------------------------------------------
PORT=5000
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NODE_ENV=development
JWT_SECRET=your_jwt_secret_here
DEMO_MODE=true

